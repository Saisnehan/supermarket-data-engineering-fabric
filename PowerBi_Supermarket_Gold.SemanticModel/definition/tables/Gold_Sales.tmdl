table Gold_Sales
	lineageTag: 4de25c82-c2bf-4dfd-8441-1b76332be9c2

	measure 'Total Orders' =
			
			DISTINCTCOUNT(Gold_Sales[OrderID])
		lineageTag: 376c0f6a-afd5-4483-bb91-15cd9b0f4d93

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Discount Rate' =
			
			DIVIDE(
			    SUM(Gold_Sales[DiscountAmount]),
			    SUM(Gold_Sales[GrossAmount]),
			    0
			)
		lineageTag: e3906966-0cf4-4180-a56d-0c179fe4e50c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Average Order Value' =
			
			DIVIDE(
			    SUM(Gold_Sales[NetAmount]),
			    DISTINCTCOUNT(Gold_Sales[OrderID]),
			    0
			)
		lineageTag: 18b90f00-538e-49f2-aadb-bdb2e29abe4c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Discount' =
			
			SUM(Gold_Sales[DiscountAmount])
		lineageTag: a896f60b-3dff-48d7-b425-9b2e5c48b6c3

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Sales' =
			
			SUM(Gold_Sales[NetAmount])
		lineageTag: 674f7d02-08f1-4516-9f35-933d42a0aaf2

		annotation PBI_FormatHint = {"isGeneralNumber":true}

